# ---------------------------------------------------------------------------
# Fitwise - environment variables
# Copy this file to `.env.local` and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# Google Gemini API key. Required for the AI features (analysis, assistant,
# cover letter, rewrites). Get a free key at https://aistudio.google.com/apikey
# The app runs without it: upload, text extraction, the ATS check and the
# bullet linter all work, and the AI features report themselves as unconfigured.
GEMINI_API_KEY=

# Optional. Overrides the default model (gemini-3.5-flash). Verified alternatives:
# gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=

# Optional. Overrides the Gemini endpoint; used to exercise the AI routes
# against scripts/gemini-stub.mjs in development. Leave unset in production.
GEMINI_BASE_URL=

# Optional. Per-IP limits for each AI route (analyze, chat, cover-letter, rewrite).
# Defaults: 10 per minute, 60 per day.
AI_RATE_LIMIT_PER_MINUTE=
AI_RATE_LIMIT_PER_DAY=

# Optional. Per-IP uploads per minute against /api/extract. Default: 20
EXTRACT_RATE_LIMIT_PER_MINUTE=

# Optional, recommended in production. With both set, rate-limit counters are
# shared across every serverless instance via Upstash Redis (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Canonical site URL for social metadata, robots.txt and the sitemap.
# Default: https://fitwise.vercel.app
NEXT_PUBLIC_SITE_URL=
